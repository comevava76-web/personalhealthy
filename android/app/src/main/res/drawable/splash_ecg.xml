<?xml version="1.0" encoding="utf-8"?>
<!-- Launch animation (Android 12+): the violet ECG trace draws itself from left to right on the app's navy. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
            <!-- scaled to 80% around the centre so the whole trace fits inside the round splash mask -->
            <group android:pivotX="54" android:pivotY="54" android:scaleX="0.8" android:scaleY="0.8">
                <path android:name="trace" android:pathData="M13,57.2 H33.5 L38.9,49.7 L44.3,57.2 H48.6 L55.1,27 L62.1,84.2 L68,57.2 H74.5 L79.9,51.8 L85.3,57.2 H95" android:strokeColor="#FF8C7BF2" android:strokeWidth="4.2" android:strokeLineCap="round" android:strokeLineJoin="round" android:fillColor="#00000000" android:trimPathEnd="0"/>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="trace">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1" android:duration="900" android:valueType="floatType" android:interpolator="@android:interpolator/fast_out_slow_in"/>
        </aapt:attr>
    </target>
</animated-vector>
